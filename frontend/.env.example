# Fun.xyz Checkout (Connect Exchange - Coinbase + Bybit)
# IMPORTANT: Backend must deploy DepositRouter.sol FIRST (non-custodial)
# Do NOT use admin wallet as destination - see CONNECT_EXCHANGE_ARCHITECTURE_FIX.md
VITE_FUNKIT_API_KEY=your_funkit_publishable_key_here
VITE_FUNKIT_ENV=sandbox
VITE_ENABLE_CONNECT_EXCHANGE=false

# MoonPay Configuration (Use Cash)
VITE_MOONPAY_API_KEY=your_moonpay_api_key_here

# Magic Configuration
VITE_MAGIC_PUBLISHABLE_KEY=pk_live_...

# WalletConnect
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Backend API
VITE_API_URL=http://localhost:5000
